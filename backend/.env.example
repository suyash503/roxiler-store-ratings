# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roxiler?schema=public"

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

PORT=4100
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS="http://localhost:5180"

# Optional. Session cookie only over HTTPS (defaults to true when NODE_ENV=production)
# COOKIE_SECURE=true
# Optional. Proxy hops to trust for the client IP; set to 1 behind nginx
# TRUST_PROXY=1
